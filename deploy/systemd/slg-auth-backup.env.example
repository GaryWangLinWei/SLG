# /etc/slg-auth-backup.env — template. Copy to /etc/slg-auth-backup.env,
# fill in real values, then `chown root:root` and `chmod 0600`.
#
# The backup process reads these variables through EnvironmentFile= in the
# systemd unit. Do NOT export OSS AccessKeyId / AccessKeySecret here — real
# credentials must come from the ECS RAM role via IMDS at runtime.
#
# Placeholders below are intentionally NOT valid values. Replace each
# <PLACEHOLDER> block with your own value before enabling the timer.

# Absolute path to the SQLite database file (must be a regular file, not a symlink).
BACKUP_DB_PATH=/root/server-auth/auth.db

# OSS region and bucket the RAM role has permission on.
BACKUP_OSS_REGION=<REPLACE_WITH_OSS_REGION>
BACKUP_OSS_BUCKET=<REPLACE_WITH_PRIVATE_BUCKET_NAME>

# Object key prefix. The daily/ prefix owns the 14-day lifecycle rule
# configured on the bucket.
BACKUP_OSS_PREFIX=daily/

# Base64-encoded 32-byte encryption key. Generate offline with:
#   openssl rand -base64 32
# Store the plaintext key material outside the VPS (password manager /
# offline drive). If lost, backups cannot be decrypted.
BACKUP_ENCRYPTION_KEY=<REPLACE_WITH_BASE64_32_BYTES>

# Optional: seconds between OSS STS token refreshes (60 .. 86400). Omit to
# use the default of one hour.
#BACKUP_OSS_STS_REFRESH_SEC=3600

# DingTalk failure/verify-success notification target. Webhook must be HTTPS
# and the secret must be the "加签" secret (starts with SEC…).
DINGTALK_WEBHOOK=<REPLACE_WITH_HTTPS_DINGTALK_WEBHOOK>
DINGTALK_SECRET=<REPLACE_WITH_DINGTALK_SIGN_SECRET>

# Optional free-form instance identifier included in log records.
INSTANCE_ID=<REPLACE_OR_LEAVE_BLANK>
