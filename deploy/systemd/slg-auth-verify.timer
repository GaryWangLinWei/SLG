[Unit]
Description=SLG auth SQLite backup — monthly restore verification — timer
Documentation=file:///root/server-auth/docs/server-auth-backup-operations.md

[Timer]
# Day 1 of every month at 04:15 Asia/Shanghai (one hour after the daily backup).
OnCalendar=*-*-01 04:15:00 Asia/Shanghai
Persistent=true
RandomizedDelaySec=600
Unit=slg-auth-verify.service
AccuracySec=1min

[Install]
WantedBy=timers.target
