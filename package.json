{
  "name": "rok-automation",
  "version": "1.2.8",
  "description": "万国觉醒自动化助手",
  "main": "dist/electron/main.js",
  "scripts": {
    "build": "tsc",
    "dev": "npm run server",
    "server": "ts-node server/index.ts",
    "server:dev": "nodemon --watch 'server/**/*.ts' --exec 'ts-node' server/index.ts",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "electron:dev": "concurrently \"cd web && npm run dev\" \"wait-on http://localhost:5173 && tsc && electron .\"",
    "electron:build": "cd web && npm run build && cd .. && tsc && node -e \"const f=require('fs');f.cpSync('assets','dist/assets',{recursive:true});f.cpSync('plugins/rok/templates','dist/plugins/rok/templates',{recursive:true});f.cpSync('plugins/rok/models','dist/plugins/rok/models',{recursive:true})\" && electron-builder",
    "electron:build:win": "node scripts/build-editions.mjs",
    "electron:publish:win": "node scripts/publish-release.mjs",
    "test:release": "node --test scripts/*.test.mjs",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "com.rok.automation",
    "productName": "ROK助手",
    "releaseInfo": {
      "releaseNotes": "1.2.8更新内容\n1.增加账号解绑功能，30天可解绑一次\n2.“建筑升级”优化：当有前置建筑未达到要求时，自动升级前置建筑\n3.“自动打野”新增循环间隔和自动使用体力药水\n4.“自动训练”增加晋升选项。\n5.修复山洞探索，重复探洞bug\n6.优化采集资源流程"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "web/dist/**/*",
      "node_modules/**/*",
      "!node_modules/onnxruntime-node/bin/napi-v6/darwin/**/*",
      "!node_modules/onnxruntime-node/bin/napi-v6/linux/**/*",
      "!node_modules/onnxruntime-node/bin/napi-v6/*/*.tar.gz",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/onnxruntime-node/**/*",
      "node_modules/@img/**/*"
    ],
    "extraResources": [
      {
        "from": "tools/platform-tools/platform-tools",
        "to": "adb",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "plugins/rok/templates",
        "to": "templates"
      },
      {
        "from": "traineddata",
        "to": "traineddata"
      },
      {
        "from": "plugins/rok/models",
        "to": "models"
      }
    ],
    "compression": "maximum",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.png",
      "artifactName": "ROK助手 Setup ${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "electron/installer.nsh"
    },
    "publish": {
      "provider": "generic",
      "url": "https://updates.slgbot.com/updates"
    }
  },
  "keywords": [
    "slg",
    "automation",
    "opencv",
    "adb"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/koa": "^2.13.0",
    "@types/koa__cors": "^5.0.1",
    "@types/koa-bodyparser": "^4.3.0",
    "@types/koa-router": "^7.4.0",
    "@types/koa-static": "^4.0.2",
    "@types/node": "^20.0.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "electron-is-dev": "^3.0.1",
    "jest": "^29.5.0",
    "nodemon": "^3.0.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0",
    "wait-on": "^9.0.10",
    "yaml": "^2.8.1"
  },
  "dependencies": {
    "@koa/cors": "^4.0.0",
    "@types/ws": "^8.18.1",
    "ali-oss": "^6.23.0",
    "electron-updater": "^6.8.3",
    "koa": "^2.14.0",
    "koa-bodyparser": "^4.4.0",
    "koa-router": "^12.0.0",
    "koa-static": "^5.0.0",
    "onnxruntime-node": "^1.26.0",
    "sharp": "^0.34.5",
    "tesseract.js": "^7.0.0",
    "ws": "^8.21.0"
  }
}
